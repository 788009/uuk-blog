---
import path from "node:path";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import PostMetadata from "@components/PostMeta.astro";
import Breadcrumb from "@components/widget/Breadcrumb.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getDir, getPostUrlBySlug, getRecordUrlBySlug } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig, profileConfig, siteConfig } from "@/config";

interface Props {
	// biome-ignore lint/suspicious/noExplicitAny: reason
	entry: any;
	// biome-ignore lint/suspicious/noExplicitAny: reason
	headings: any[];
	// biome-ignore lint/suspicious/noExplicitAny: reason
	remarkPluginFrontmatter: any;
	jsonLdType?: string;
	showWordCount?: boolean;
	showReadingTime?: boolean;
	showReadCount?: boolean;
	showBreadcrumb?: boolean;
	showTitle?: boolean;
	showMetadata?: boolean;
	showCover?: boolean;
	showContent?: boolean;
	showLicense?: boolean;
	showNextAndPrev?: boolean;
}

const {
	entry,
	headings,
	remarkPluginFrontmatter,
	jsonLdType = "Article",
	showWordCount = false,
	showReadingTime = false,
	showReadCount = false,
	showBreadcrumb = false,
	showTitle = true,
	showMetadata = false,
	showCover = true,
	showContent = true,
	showLicense = false,
	showNextAndPrev = false,
} = Astro.props;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": jsonLdType,
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};

const basePath = path.join(`content/${entry.collection}/`, getDir(entry.id));

const getUrlBySlug = (slug: string) => {
	if (entry.collection === "records") return getRecordUrlBySlug(slug);
	if (entry.collection === "posts" && getPostUrlBySlug)
		return getPostUrlBySlug(slug);
	return `/${entry.collection}/${slug}`;
};
---

<MainGridLayout banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={entry.data.lang} setOGTypeArticle={true} headings={headings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div id="record-container" class:list={["card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full "]}>
            
            {/* Stats and breadcrumb */}
            {(showWordCount || showReadingTime || showReadCount || showBreadcrumb) && (
                <div class="flex flex-col md:flex-row items-start md:items-center text-black/30 dark:text-white/30 gap-2 md:gap-5 mb-3 transition onload-animation w-full">
                    <div class="flex flex-row items-center gap-5 shrink-0">
                        {showWordCount && (
                            <div class="flex flex-row items-center">
                                <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                                    <Icon name="material-symbols:notes-rounded"></Icon>
                                </div>
                                <div class="text-sm">{remarkPluginFrontmatter.words} {" " + i18n(I18nKey.wordsCount)}</div>
                            </div>
                        )}
                        {showReadingTime && (
                            <div class="flex flex-row items-center">
                                <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                                    <Icon name="material-symbols:schedule-outline-rounded"></Icon>
                                </div>
                                <div class="text-sm">
                                    {remarkPluginFrontmatter.minutes} {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                                </div>
                            </div>
                        )}
                        {showReadCount && (
                            <div id="busuanzi_container_page_pv" style="display:none">
                                <div class="flex flex-row items-center">
                                    <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2">
                                        <Icon name="material-symbols:visibility-outline-rounded"></Icon>
                                    </div>
                                    <div class="text-sm" id="busuanzi_value_page_pv"></div>
                                </div>
                            </div>
                        )}
                    </div>

                    {showBreadcrumb && (
                        <div class="flex flex-row items-center min-w-0 w-full flex-1">
                            <div class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2 shrink-0">
                                <Icon name="material-symbols:map-outline-rounded"></Icon>
                            </div>
                            <div class="text-sm flex items-center min-w-0 w-full">
                                <Breadcrumb />
                            </div>
                        </div>
                    )}
                </div>
            )}

            {/* Article title */}
            {showTitle && (
                <div class="relative onload-animation">
                    <div
                        data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title"
                        class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-black/90 dark:text-white/90 md:before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)] before:absolute before:top-[0.75rem] before:left-[-1.125rem]">
                        {entry.data.title}
                    </div>
                </div>
            )}

            {/* Metadata (date, category, tags) */}
            {showMetadata && (
                <PostMetadata class="onload-animation mb-4" published={entry.data.published} tags={entry.data.tags} category={entry.data.category} />
            )}

            {/* Cover */}
            {showCover && entry.data.image && (
                <ImageWrapper id="record-cover" src={entry.data.image} basePath={basePath} class="mb-8 rounded-xl banner-container onload-animation"/>
            )}

            {/* Content */}
            {showContent && (
                <Markdown class="mb-6 markdown-content onload-animation">
                    <slot />
                </Markdown>
            )}

            {/* License */}
            {showLicense && licenseConfig.enable && (
                <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} class="mb-6 rounded-xl license-container onload-animation"></License>
            )}
        </div>
    </div>

    {/* Next / Prev nav */}
    {showNextAndPrev && (
        <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
            <a href={entry.data.nextSlug ? getUrlBySlug(entry.data.nextSlug) : "#"} class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.nextSlug}]}>
                {entry.data.nextSlug && (
                    <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                        <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                        <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                            {entry.data.nextTitle}
                        </div>
                    </div>
                )}
            </a>

            <a href={entry.data.prevSlug ? getUrlBySlug(entry.data.prevSlug) : "#"} class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !entry.data.prevSlug}]}>
                {entry.data.prevSlug && (
                    <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                        <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                            {entry.data.prevTitle}
                        </div>
                        <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
                    </div>
                )}
            </a>
        </div>
    )}
</MainGridLayout>
